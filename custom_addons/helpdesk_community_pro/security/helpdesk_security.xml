<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_helpdesk" model="ir.module.category">
        <field name="name">Helpdesk</field>
        <field name="sequence">20</field>
    </record>

    <!-- PORT-19: res.groups.category_id was removed; groups now point to an
         optional res.groups.privilege, which itself carries category_id.
         Pattern matches core (see project/security/project_security.xml). -->
    <record id="res_groups_privilege_helpdesk" model="res.groups.privilege">
        <field name="name">Helpdesk</field>
        <field name="category_id" ref="module_category_helpdesk"/>
    </record>

    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">User: Agent</field>
        <field name="privilege_id" ref="res_groups_privilege_helpdesk"/>
    </record>

    <record id="group_helpdesk_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
    </record>

    <record id="helpdesk_team_comp_rule" model="ir.rule">
        <field name="name">Helpdesk Team: multi-company</field>
        <field name="model_id" ref="model_helpdesk_team"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="helpdesk_ticket_comp_rule" model="ir.rule">
        <field name="name">Helpdesk Ticket: multi-company</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="helpdesk_sla_comp_rule" model="ir.rule">
        <field name="name">Helpdesk SLA: multi-company</field>
        <field name="model_id" ref="model_helpdesk_sla"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="helpdesk_ticket_rule_portal" model="ir.rule">
        <field name="name">Helpdesk Ticket: portal users see own tickets only</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
