#. module: helpdesk_community_pro
#: model:mail.template,body_html:helpdesk_community_pro.mail_template_ticket_received
msgid ""
"<div>\n"
"    Hello <t t-out=\"object.partner_name or ''\">there</t>,<br/><br/>\n"
"    Thanks for reaching out. We've created ticket <strong t-out=\"object.ref\">TKT/2024/00001</strong>\n"
"    for \"<t t-out=\"object.name\">your request</t>\" and someone from our team will get back to you shortly.\n"
"    <br/><br/>\n"
"    Helpdesk Team\n"
"</div>\n"
"            "
msgstr ""

#. module: helpdesk_community_pro
#: model:mail.template,body_html:helpdesk_community_pro.mail_template_ticket_rating
msgid ""
"<div>\n"
"    Hello <t t-out=\"object.partner_name or ''\">there</t>,<br/><br/>\n"
"    We just closed ticket <strong t-out=\"object.ref\">TKT/2024/00001</strong> for\n"
"    \"<t t-out=\"object.name\">your request</t>\". How did we do?\n"
"    <br/><br/>\n"
"    <table style=\"margin: 0 auto;\">\n"
"        <tr>\n"
"            <td style=\"padding: 0 8px;\">\n"
"                <a t-attf-href=\"#{object.get_base_url()}/helpdesk/rate/#{object.id}/#{object.rating_token}/good\" style=\"background-color:#28a745;color:#fff;padding:10px 18px;border-radius:4px;text-decoration:none;\">Good</a>\n"
"            </td>\n"
"            <td style=\"padding: 0 8px;\">\n"
"                <a t-attf-href=\"#{object.get_base_url()}/helpdesk/rate/#{object.id}/#{object.rating_token}/okay\" style=\"background-color:#ffc107;color:#000;padding:10px 18px;border-radius:4px;text-decoration:none;\">Okay</a>\n"
"            </td>\n"
"            <td style=\"padding: 0 8px;\">\n"
"                <a t-attf-href=\"#{object.get_base_url()}/helpdesk/rate/#{object.id}/#{object.rating_token}/bad\" style=\"background-color:#dc3545;color:#fff;padding:10px 18px;border-radius:4px;text-decoration:none;\">Bad</a>\n"
"            </td>\n"
"        </tr>\n"
"    </table>\n"
"    <br/>\n"
"    Helpdesk Team\n"
"</div>\n"
"            "
msgstr ""

