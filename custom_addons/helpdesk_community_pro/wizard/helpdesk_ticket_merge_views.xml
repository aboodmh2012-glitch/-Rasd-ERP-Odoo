<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_merge_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.merge.form</field>
        <field name="model">helpdesk.ticket.merge</field>
        <field name="arch" type="xml">
            <form string="Merge Ticket">
                <group>
                    <field name="destination_ticket_id"/>
                    <field name="source_ticket_id"/>
                </group>
                <p class="text-muted">
                    The ticket to merge will have its messages, followers
                    and attachments moved into the destination, then be
                    closed with a reference to it. Both tickets must
                    currently be open.
                </p>
                <footer>
                    <button
                        string="Merge"
                        name="action_merge"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="helpdesk_ticket_merge_action" model="ir.actions.act_window">
        <field name="name">Merge Ticket</field>
        <field name="res_model">helpdesk.ticket.merge</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
