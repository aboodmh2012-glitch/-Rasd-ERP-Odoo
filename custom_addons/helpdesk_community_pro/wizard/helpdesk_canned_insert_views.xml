<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_canned_insert_view_form" model="ir.ui.view">
        <field name="name">helpdesk.canned.insert.form</field>
        <field name="model">helpdesk.canned.insert</field>
        <field name="arch" type="xml">
            <form string="Insert Canned Response">
                <group>
                    <field name="ticket_id" invisible="1"/>
                    <field name="team_id" invisible="1"/>
                    <field name="canned_response_id"/>
                </group>
                <field name="body_preview"/>
                <footer>
                    <button
                        string="Insert"
                        name="action_insert"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="helpdesk_canned_insert_action" model="ir.actions.act_window">
        <field name="name">Insert Canned Response</field>
        <field name="res_model">helpdesk.canned.insert</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
