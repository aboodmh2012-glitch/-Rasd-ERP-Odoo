<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_ticket_received" model="mail.template">
            <field name="name">Helpdesk: Ticket Received</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">We received your request ({{ object.ref }})</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    Hello <t t-out="object.partner_name or ''">there</t>,<br/><br/>
    Thanks for reaching out. We've created ticket <strong t-out="object.ref">TKT/2024/00001</strong>
    for "<t t-out="object.name">your request</t>" and someone from our team will get back to you shortly.
    <br/><br/>
    Helpdesk Team
</div>
            </field>
        </record>

        <record id="mail_template_ticket_rating" model="mail.template">
            <field name="name">Helpdesk: Ticket Rating Request</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">How did we do? ({{ object.ref }})</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    Hello <t t-out="object.partner_name or ''">there</t>,<br/><br/>
    We just closed ticket <strong t-out="object.ref">TKT/2024/00001</strong> for
    "<t t-out="object.name">your request</t>". How did we do?
    <br/><br/>
    <table style="margin: 0 auto;">
        <tr>
            <td style="padding: 0 8px;">
                <a t-attf-href="#{object.get_base_url()}/helpdesk/rate/#{object.id}/#{object.rating_token}/good" style="background-color:#28a745;color:#fff;padding:10px 18px;border-radius:4px;text-decoration:none;">Good</a>
            </td>
            <td style="padding: 0 8px;">
                <a t-attf-href="#{object.get_base_url()}/helpdesk/rate/#{object.id}/#{object.rating_token}/okay" style="background-color:#ffc107;color:#000;padding:10px 18px;border-radius:4px;text-decoration:none;">Okay</a>
            </td>
            <td style="padding: 0 8px;">
                <a t-attf-href="#{object.get_base_url()}/helpdesk/rate/#{object.id}/#{object.rating_token}/bad" style="background-color:#dc3545;color:#fff;padding:10px 18px;border-radius:4px;text-decoration:none;">Bad</a>
            </td>
        </tr>
    </table>
    <br/>
    Helpdesk Team
</div>
            </field>
        </record>
    </data>
</odoo>
