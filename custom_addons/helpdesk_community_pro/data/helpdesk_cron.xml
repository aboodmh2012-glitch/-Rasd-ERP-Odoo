<?xml version="1.0" encoding="utf-8"?>
<!-- These crons are immediately eligible to run once loaded (default
     nextcall). In test runs with demo data installed, a live cron worker
     thread can race an HttpCase request's session validation, since
     committed demo records (unlike a TransactionCase's own rolled back
     test data) are visible to that separate thread, surfacing as a
     spurious "Session expired". Fix is at the test invocation, not here:
     run with max-cron-threads set to 0 (see .github/workflows/ci.yml). -->
<odoo>
    <record id="ir_cron_helpdesk_sla_status" model="ir.cron">
        <field name="name">Helpdesk: Update SLA Status</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_sla_status()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_helpdesk_open_hours" model="ir.cron">
        <field name="name">Helpdesk: Update Open Hours</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_open_hours()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
