<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="portal_my_home_ticket"
        name="Show Tickets on Portal Home"
        customize_show="True"
        inherit_id="portal.portal_my_home"
        priority="50"
    >
        <!-- portal_client_category is rendered t-if="portal_client_category_enable"
             (default False); enable it here the same way sale/account do for
             their own "Your Orders"/"Your Invoices" cards, then insert this
             module's card inside that now-enabled container. A card placed
             directly inside o_portal_docs itself (outside every category div)
             stays permanently hidden: portal_docs_entry defaults to a d-none
             class unless config_card is set, which the JS that reveals cards
             only clears for cards inside the known category containers. -->
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Tickets</t>
                <t t-set="url" t-value="'/my/tickets'"/>
                <t t-set="text">Follow, review and reply to your support tickets</t>
                <t t-set="placeholder_count" t-value="'ticket_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_my_tickets" name="My Tickets">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Tickets</t>
            </t>
            <t t-if="not tickets">
                <div class="alert alert-warning" role="alert">
                    There are no tickets.
                </div>
            </t>
            <t t-if="tickets" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Reference</th>
                        <th>Subject</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="tickets" t-as="ticket">
                        <td>
                            <a t-attf-href="/my/ticket/#{ticket.id}?{{ keep_query() }}">
                                <t t-esc="ticket.ref"/>
                            </a>
                        </td>
                        <td>
                            <t t-esc="ticket.name"/>
                        </td>
                        <td>
                            <t t-esc="ticket.stage_id.name"/>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_ticket_page" name="Ticket Portal Page">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'ticket'"/>
            <div class="row o_portal_ticket_content">
                <div class="col-12">
                    <h3>
                        <t t-esc="object.ref"/>
                        -
                        <t t-esc="object.name"/>
                    </h3>
                    <p>Status: <t t-esc="object.stage_id.name"/></p>
                    <p t-if="object.description" t-field="object.description"/>
                </div>
            </div>
            <hr/>
            <div id="ticket_communication" data-anchor="true">
                <h4>Communication history</h4>
                <t t-call="portal.message_thread">
                    <t t-set="token" t-value="access_token"/>
                </t>
            </div>
        </t>
    </template>
</odoo>
