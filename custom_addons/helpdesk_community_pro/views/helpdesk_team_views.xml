<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_team_view_form" model="ir.ui.view">
        <field name="name">helpdesk.team.form</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Team">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_tickets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-ticket"
                        >
                            <field name="ticket_count" widget="statinfo" string="Tickets"/>
                        </button>
                        <button
                            name="action_view_tickets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-smile-o"
                            invisible="not csat_enabled"
                        >
                            <field
                                name="csat_avg"
                                widget="statinfo"
                                string="CSAT"
                                digits="[0, 0]"
                            />
                        </button>
                        <button
                            name="action_view_tickets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-check-circle"
                        >
                            <field
                                name="sla_compliance"
                                widget="statinfo"
                                string="SLA Compliance"
                                digits="[0, 0]"
                            />
                        </button>
                        <button
                            name="action_view_tickets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-clock-o"
                        >
                            <field
                                name="avg_resolution_hours"
                                widget="statinfo"
                                string="Avg. Resolution (h)"
                                digits="[0, 1]"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Customer Support"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_ids" widget="many2many_avatar_user"/>
                            <field name="calendar_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="csat_enabled"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Email Alias" groups="helpdesk_community_pro.group_helpdesk_manager">
                        <div colspan="2">
                            <!-- alias_id must be in the view for alias_domain_id to default correctly -->
                            <field name="alias_id" invisible="1"/>
                            <label
                                for="alias_name"
                                string="Create tickets by sending an email to"
                            />
                            <field
                                name="alias_email"
                                class="oe_read_only d-inline"
                                widget="email"
                                readonly="1"
                                invisible="not alias_name"
                            />
                            <span class="oe_edit_only o_row">
                                <field name="alias_name" placeholder="e.g. support"/>@
                                <field
                                    name="alias_domain_id"
                                    class="oe_inline"
                                    placeholder="e.g. domain.com"
                                    options="{'no_create': True, 'no_open': True}"
                                />
                            </span>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_team_view_list" model="ir.ui.view">
        <field name="name">helpdesk.team.list</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <list string="Teams">
                <field name="name"/>
                <field name="member_ids" widget="many2many_avatar_user"/>
                <field name="calendar_id"/>
                <field name="ticket_count"/>
                <field name="csat_avg" digits="[0, 0]" optional="show"/>
                <field name="sla_compliance" digits="[0, 0]" optional="show"/>
                <field name="avg_resolution_hours" digits="[0, 1]" optional="show"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_team_view_kanban" model="ir.ui.view">
        <field name="name">helpdesk.team.kanban</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <!-- PORT-19: kanban template renamed kanban-box -> card, with a
                 separate "menu" template for the kebab dropdown (color
                 picker); no manual oe_kanban_card wrapper or dropdown
                 markup needed, the framework generates both now. Pattern
                 matches core (project/views/project_project_views.xml). -->
            <kanban highlight_color="color" class="o_kanban_dashboard">
                <field name="name"/>
                <field name="ticket_count"/>
                <field name="color"/>
                <field name="member_ids"/>
                <templates>
                    <t t-name="menu" groups="base.group_user">
                        <div role="menuitem">
                            <field name="color" widget="kanban_color_picker"/>
                        </div>
                    </t>
                    <t t-name="card">
                        <main>
                            <span class="text-truncate d-block fs-5 fw-bold">
                                <field name="name"/>
                            </span>
                        </main>
                        <footer>
                            <a
                                name="action_view_tickets"
                                type="object"
                                class="d-flex align-items-baseline"
                            >
                                <field name="ticket_count" class="o_value me-1"/>
                                <span>Tickets</span>
                            </a>
                            <field
                                name="member_ids"
                                widget="many2many_avatar_user"
                                class="ms-auto"
                            />
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="helpdesk_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first helpdesk team
            </p>
        </field>
    </record>
</odoo>
