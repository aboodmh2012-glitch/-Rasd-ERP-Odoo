<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Minimal, standalone page (no portal/website layout): reached by an
         anonymous customer clicking a link in the CSAT email, so it can't
         assume a logged-in session the way /my/* portal pages can. -->
    <template id="rating_feedback_page" name="Helpdesk Rating Feedback">
        <html>
            <head>
                <title>Helpdesk Pro</title>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <style>
                    body {
                        font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
                        background: #f5f5f5;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        min-height: 100vh;
                        margin: 0;
                    }
                    .o_rating_card {
                        background: #fff;
                        border-radius: 8px;
                        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
                        padding: 2.5rem;
                        max-width: 420px;
                        text-align: center;
                    }
                    .o_rating_card h1 {
                        font-size: 1.4rem;
                        margin-bottom: 0.5rem;
                    }
                    .o_rating_card p {
                        color: #666;
                    }
                    .o_rating_brand {
                        color: #875a7b;
                        font-weight: bold;
                        margin-top: 2rem;
                        font-size: 0.9rem;
                    }
                </style>
            </head>
            <body>
                <div class="o_rating_card">
                    <t t-if="state == 'thanks'">
                        <h1>Thank you for your feedback!</h1>
                        <p>
                            You rated ticket <t t-esc="ticket.ref"/> as
                            "<t t-esc="rating_label"/>".
                        </p>
                    </t>
                    <t t-elif="state == 'locked'">
                        <h1>This rating can no longer be changed</h1>
                        <p>
                            Feedback for ticket <t t-esc="ticket.ref"/> was
                            already recorded and the update window has closed.
                        </p>
                    </t>
                    <t t-else="">
                        <h1>This rating link is not valid</h1>
                        <p>
                            It may have expired or been used incorrectly.
                            Please contact us if you need help.
                        </p>
                    </t>
                    <div class="o_rating_brand">Helpdesk Pro</div>
                </div>
            </body>
        </html>
    </template>
</odoo>
