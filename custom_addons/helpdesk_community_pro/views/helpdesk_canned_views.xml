<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_canned_response_view_list" model="ir.ui.view">
        <field name="name">helpdesk.canned.response.list</field>
        <field name="model">helpdesk.canned.response</field>
        <field name="arch" type="xml">
            <list string="Canned Responses">
                <field name="name"/>
                <field name="team_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_canned_response_view_form" model="ir.ui.view">
        <field name="name">helpdesk.canned.response.form</field>
        <field name="model">helpdesk.canned.response</field>
        <field name="arch" type="xml">
            <form string="Canned Response">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="team_ids" widget="many2many_tags"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_canned_response_action" model="ir.actions.act_window">
        <field name="name">Canned Responses</field>
        <field name="res_model">helpdesk.canned.response</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first canned response
            </p>
        </field>
    </record>
</odoo>
